# MEXC API
MEXC_API_KEY=your_api_key
MEXC_API_SECRET=your_api_secret
MEXC_BASE_URL=https://api.mexc.com

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=471040489
# Storage
LOG_TO_CSV=true
CSV_OUTPUT_PATH=./output

# Scanner
SCAN_INTERVAL_MS=60000
MIN_DEPTH_USD=2000
MAX_SPREAD_PCT=0.5
MIN_ATR_1M=0.001
MIN_24H_CHANGE_PCT=5

# Signals
ATR_MULTIPLE=1.5
TP_PCT_1=0.2
TP_PCT_2=0.4
SL_ATR_MULTIPLE=2

# Risk
MAX_RISK_PER_TRADE_PCT=1
MAX_POSITIONS=5

# Mode
PAPER_TRADING=true

# Logging
LOG_LEVEL=info
LOG_SCANNER_DETAILS=true
LOG_SIGNAL_DETAILS=true
LOG_EXECUTION_DETAILS=true
